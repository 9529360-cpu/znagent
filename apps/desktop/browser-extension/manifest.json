{
  "manifest_version": 3,
  "name": "ZN User Browser Bridge",
  "version": "0.1.0",
  "description": "Explicitly authorize the current browser tab for the local ZN resident.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["activeTab", "debugger", "storage"],
  "host_permissions": ["http://127.0.0.1:19991/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Allow ZN to use this tab"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Authorize or revoke ZN access to the current tab"
    }
  }
}
